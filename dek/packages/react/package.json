{
  "name": "@fair/react",
  "version": "59.2.0",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "author": "AOE",
  "license": "UNLICENSED",
  "files": [
    "dist/**"
  ],
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests",
    "ts:check": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "generate": "cross-env NODE_OPTIONS='--import tsx' plop --plopfile=plopfile.ts",
    "generate:readme": "markdown-include readme/markdown.json",
    "coverage": "vitest run --coverage",
    "build": "pnpm generate:readme && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "preview": "vite preview",
    "llms": "tsx scripts/storybook-llms-extractor/cli.ts --config llms.config.json",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "cross-env NODE_OPTIONS=--max-old-space-size=8192 storybook build",
    "storybook-serve": "http-server ./storybook-static -p 6006",
    "test:visual:local": "playwright test -c ./playwright/environments-ct/playwright.config.local.ts",
    "test:visual:local:ui": "pnpm run test:visual:local --ui",
    "test:visual:os-agnostic:delete": "docker image rm --force fair-test-visual",
    "test:visual:os-agnostic:build": "pnpm run test:visual:os-agnostic:delete && cd ../../ && cross-replace docker build --force-rm --no-cache --build-arg NPM_TOKEN=$NPM_TOKEN --build-arg CONGSTAR_GITLAB_FAIR_NPM_TOKEN=$CONGSTAR_GITLAB_FAIR_NPM_TOKEN -t fair-test-visual -f Dockerfile.test-visual .",
    "test:visual:os-agnostic:start:internal": "pnpm install && pnpm playwright test -c ./playwright/environments-ct/playwright.config.local.os-agnostic.ts",
    "test:visual:os-agnostic:start": "cd ../../ && cross-env IMAGE_NAME='fair-test-visual' ts-node ./startTestVisual.ts pnpm test:visual:os-agnostic:start:internal",
    "test:visual:os-agnostic": "pnpm test:visual:os-agnostic:build && pnpm test:visual:os-agnostic:start",
    "test:visual:ci": "playwright test -c ./playwright/environments-ct/playwright.config.ci.ts"
  },
  "dependencies": {
    "@fair/global-css": "workspace:*",
    "@fair/tokens": "workspace:*",
    "@radix-ui/react-accordion": "catalog:",
    "@radix-ui/react-checkbox": "catalog:",
    "@radix-ui/react-collapsible": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-radio-group": "catalog:",
    "@radix-ui/react-select": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-switch": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@radix-ui/react-toggle": "catalog:",
    "@radix-ui/react-toggle-group": "catalog:",
    "@react-aria/utils": "catalog:",
    "polished": "catalog:",
    "react-aria": "catalog:",
    "react-aria-components": "catalog:",
    "react-stately": "catalog:"
  },
  "peerDependencies": {
    "@fair/icons": "workspace:*",
    "@internationalized/date": "catalog:",
    "html-react-parser": "catalog:",
    "react": "^18.0 || ^19.0",
    "react-dom": "^18.0 || ^19.0",
    "styled-components": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@fair/icons": "workspace:*",
    "@internationalized/date": "catalog:",
    "@playwright/experimental-ct-core": "catalog:",
    "@playwright/experimental-ct-react": "catalog:",
    "@playwright/test": "catalog:",
    "@react-types/shared": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "change-case": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "eslint-config-custom": "workspace:*",
    "eslint-plugin-storybook": "catalog:",
    "happy-dom": "catalog:",
    "html-react-parser": "catalog:",
    "http-server": "catalog:",
    "markdown-include": "catalog:",
    "mockdate": "catalog:",
    "plop": "catalog:",
    "prop-types": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "styled-components": "catalog:",
    "stylis": "catalog:",
    "tsx": "catalog:",
    "turndown": "catalog:",
    "turndown-plugin-gfm": "catalog:",
    "typescript": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
